{
  "name": "myenterprise",
  "private": true,
  "type": "module",
  "description": "MyEnterprise — fashion commerce database project: MariaDB schema and routines, PHP API, React storefront and admin.",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
    "api": "php -S 127.0.0.1:8000 -t public public/router.php",
    "seed": "node tools/seed/generate-seed.mjs && node tools/seed/generate-images.mjs && node tools/build-sql.mjs",
    "build:sql": "node tools/build-sql.mjs",
    "art": "node tools/art/generate-art.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:api": "node --test tests/api.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.1.0",
    "@fontsource/instrument-serif": "5.1.0",
    "@tanstack/react-query": "5.59.16",
    "framer-motion": "11.11.17",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.5"
  }
}
